{
  "name": "nanometrics",
  "displayName": "Nano Metrics",
  "icon": "images/logo.png",
  "publisher": "nuhmanpk",
  "description": "Explore and monitor system metrics effortlessly with this quick and convenient VSCode extension. Access real-time information on CPU load, memory usage, core load, and running instances of various services right from the side panel. Stay informed about your system's health and performance with ease.",
  "version": "0.5.0",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/nuhmanpk/nanometrics.git"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nanometrics-sidebar",
          "title": "Nano Metrics",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "nanometrics-sidebar": [
        {
          "type": "webview",
          "id": "nanometrics.dashboard",
          "name": "Dashboard",
          "icon": "media/activity.svg"
        }
      ],
      "explorer": [
        {
          "type": "webview",
          "id": "nanometrics.explorer",
          "name": "NanoMetrics",
          "icon": "media/activity.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "nanometrics.showSystem",
        "title": "Show System Metrics",
        "category": "Nano Metrics",
        "icon": "$(dashboard)"
      },
      {
        "command": "nanometrics.showProject",
        "title": "Show Project Monitor",
        "category": "Nano Metrics",
        "icon": "$(project)"
      },
      {
        "command": "nanometrics.showClaude",
        "title": "Show Claude Code Activity",
        "category": "Nano Metrics",
        "icon": "$(sparkle)"
      },
      {
        "command": "nanometrics.togglePause",
        "title": "Pause / Resume Monitoring",
        "category": "Nano Metrics",
        "icon": "$(debug-pause)"
      },
      {
        "command": "nanometrics.openSettings",
        "title": "Open Settings",
        "category": "Nano Metrics",
        "icon": "$(gear)"
      },
      {
        "command": "nanometrics.focus",
        "title": "Open Dashboard",
        "category": "Nano Metrics"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Nano Metrics Settings",
      "properties": {
        "nanometrics.refreshInterval": {
          "type": "number",
          "default": 2000,
          "minimum": 1000,
          "description": "How often metrics refresh, in milliseconds."
        },
        "nanometrics.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show CPU and memory usage in the status bar."
        },
        "nanometrics.warningThreshold": {
          "type": "number",
          "default": 85,
          "minimum": 1,
          "maximum": 100,
          "description": "Usage percentage at which CPU and memory are highlighted as a warning."
        },
        "nanometrics.statusBarStyle": {
          "type": "string",
          "enum": [
            "full",
            "compact"
          ],
          "enumDescriptions": [
            "CPU and memory with icons, e.g. 12%  45%.",
            "Shortest form, e.g. 12·45%."
          ],
          "default": "full",
          "description": "How much space the status bar item takes."
        },
        "nanometrics.claudePricing": {
          "type": "object",
          "default": {},
          "description": "Override model prices (USD per million tokens) used for the Claude Code cost estimate. Keys match part of the model id, values are [input, output] or [input, output, cache read]; overrides are matched before the built-in prices. Example: { \"sonnet-5-5\": [2, 10, 0.1] }.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "nanometrics.showGraph": {
          "type": "boolean",
          "default": true,
          "description": "Show live history graphs for CPU, memory, network and project usage."
        },
        "nanometrics.enableMysql": {
          "type": "boolean",
          "default": false,
          "description": "Enable MySQL metrics."
        },
        "nanometrics.enableMongoDB": {
          "type": "boolean",
          "default": false,
          "description": "Enable MongoDB metrics."
        },
        "nanometrics.enableRedis": {
          "type": "boolean",
          "default": false,
          "description": "Enable Redis metrics."
        },
        "nanometrics.enableDocker": {
          "type": "boolean",
          "default": false,
          "description": "Enable Docker metrics."
        },
        "nanometrics.enableNginx": {
          "type": "boolean",
          "default": false,
          "description": "Enable Nginx metrics."
        },
        "nanometrics.enableApache": {
          "type": "boolean",
          "default": false,
          "description": "Enable Apache metrics."
        },
        "nanometrics.enableElasticsearch": {
          "type": "boolean",
          "default": false,
          "description": "Enable Elasticsearch metrics."
        },
        "nanometrics.enableRabbitMQ": {
          "type": "boolean",
          "default": false,
          "description": "Enable RabbitMQ metrics."
        },
        "nanometrics.enableKafka": {
          "type": "boolean",
          "default": false,
          "description": "Enable Kafka metrics."
        },
        "nanometrics.enablePostgres": {
          "type": "boolean",
          "default": false,
          "description": "Enable Postgres metrics."
        },
        "nanometrics.enableOracleDB": {
          "type": "boolean",
          "default": false,
          "description": "Enable OracleDB metrics."
        },
        "nanometrics.enableSqlServer": {
          "type": "boolean",
          "default": false,
          "description": "Enable SQL Server metrics."
        },
        "nanometrics.enableNeo4j": {
          "type": "boolean",
          "default": false,
          "description": "Enable Neo4j metrics."
        },
        "nanometrics.enableCassandra": {
          "type": "boolean",
          "default": false,
          "description": "Enable Cassandra metrics."
        },
        "nanometrics.enableMariaDB": {
          "type": "boolean",
          "default": false,
          "description": "Enable MariaDB metrics."
        },
        "nanometrics.enableCouchDB": {
          "type": "boolean",
          "default": false,
          "description": "Enable CouchDB metrics."
        },
        "nanometrics.enableInfluxDB": {
          "type": "boolean",
          "default": false,
          "description": "Enable InfluxDB metrics."
        },
        "nanometrics.enableClickHouse": {
          "type": "boolean",
          "default": false,
          "description": "Enable ClickHouse metrics."
        },
        "nanometrics.enableMemcached": {
          "type": "boolean",
          "default": false,
          "description": "Enable Memcached metrics."
        },
        "nanometrics.enableEtcd": {
          "type": "boolean",
          "default": false,
          "description": "Enable etcd metrics."
        },
        "nanometrics.enableConsul": {
          "type": "boolean",
          "default": false,
          "description": "Enable Consul metrics."
        },
        "nanometrics.enableZookeeper": {
          "type": "boolean",
          "default": false,
          "description": "Enable ZooKeeper metrics."
        },
        "nanometrics.enablePrometheus": {
          "type": "boolean",
          "default": false,
          "description": "Enable Prometheus metrics."
        },
        "nanometrics.enableGrafana": {
          "type": "boolean",
          "default": false,
          "description": "Enable Grafana metrics."
        },
        "nanometrics.enableMinIO": {
          "type": "boolean",
          "default": false,
          "description": "Enable MinIO metrics."
        },
        "nanometrics.enableHAProxy": {
          "type": "boolean",
          "default": false,
          "description": "Enable HAProxy metrics."
        },
        "nanometrics.enableTraefik": {
          "type": "boolean",
          "default": false,
          "description": "Enable Traefik metrics."
        },
        "nanometrics.enableOllama": {
          "type": "boolean",
          "default": false,
          "description": "Enable Ollama metrics."
        },
        "nanometrics.enableGpu": {
          "type": "boolean",
          "default": false,
          "description": "Show GPU information."
        },
        "nanometrics.enableBattery": {
          "type": "boolean",
          "default": false,
          "description": "Show battery status."
        },
        "nanometrics.enableNetwork": {
          "type": "boolean",
          "default": true,
          "description": "Show network throughput for the default interface."
        },
        "nanometrics.enableDisk": {
          "type": "boolean",
          "default": true,
          "description": "Show disk usage."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "nanometrics.togglePause",
          "when": "view == nanometrics.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "nanometrics.openSettings",
          "when": "view == nanometrics.dashboard",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "test:unit": "mocha --ui tdd \"out/test/unit/**/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.19.17",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.56.0",
    "mocha": "^10.8.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "systeminformation": "^5.33.16"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.1",
    "serialize-javascript": "^7.1.4"
  }
}
