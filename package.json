{
  "name": "nanometrics",
  "displayName": "Nano Metrics: Claude Code Usage, Cost & System Monitor",
  "icon": "images/logo.png",
  "publisher": "nuhmanpk",
  "description": "Track Claude Code live in the sidebar: tokens, cost, context window, plan usage limits, tool calls and subagents. Plus CPU, memory, network, ports and dev processes for your project.",
  "version": "0.8.0",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/nuhmanpk/nanometrics#readme",
  "bugs": {
    "url": "https://github.com/nuhmanpk/nanometrics/issues"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/nuhmanpk"
  },
  "qna": "https://github.com/nuhmanpk/nanometrics/issues",
  "galleryBanner": {
    "color": "#16161c",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "claude-code",
    "anthropic",
    "ai",
    "token usage",
    "token counter",
    "ai cost",
    "cost tracker",
    "context window",
    "usage limits",
    "rate limit",
    "agent monitor",
    "vibe coding",
    "ai agent",
    "system monitor",
    "cpu",
    "memory",
    "ram",
    "performance",
    "resource monitor",
    "task manager",
    "process manager",
    "ports",
    "network",
    "temperature",
    "dashboard",
    "status bar",
    "devtools",
    "metrics"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/nuhmanpk/nanometrics.git"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nanometrics-sidebar",
          "title": "Nano Metrics",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "nanometrics-sidebar": [
        {
          "type": "webview",
          "id": "nanometrics.dashboard",
          "name": "Dashboard",
          "icon": "media/activity.svg"
        }
      ],
      "explorer": [
        {
          "type": "webview",
          "id": "nanometrics.explorer",
          "name": "NanoMetrics",
          "icon": "media/activity.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "nanometrics.showSystem",
        "title": "Show System Metrics",
        "category": "Nano Metrics",
        "icon": "$(dashboard)"
      },
      {
        "command": "nanometrics.showProject",
        "title": "Show Project Monitor",
        "category": "Nano Metrics",
        "icon": "$(project)"
      },
      {
        "command": "nanometrics.showClaude",
        "title": "Show Claude Code Activity",
        "category": "Nano Metrics",
        "icon": "$(sparkle)"
      },
      {
        "command": "nanometrics.togglePause",
        "title": "Pause / Resume Monitoring",
        "category": "Nano Metrics",
        "icon": "$(debug-pause)"
      },
      {
        "command": "nanometrics.openSettings",
        "title": "Open Settings",
        "category": "Nano Metrics",
        "icon": "$(gear)"
      },
      {
        "command": "nanometrics.focus",
        "title": "Open Dashboard",
        "category": "Nano Metrics"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Nano Metrics Settings",
      "properties": {
        "nanometrics.refreshInterval": {
          "type": "number",
          "default": 2000,
          "minimum": 1000,
          "description": "How often metrics refresh, in milliseconds."
        },
        "nanometrics.claudeContextWarning": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "description": "Warn once per chat when a live Claude Code chat's context passes this percent of its window. 0 turns it off."
        },
        "nanometrics.claudeDailyBudget": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Cost limit: warn once a day, with a sound, when today's estimated Claude Code cost in this workspace (API pricing, USD) passes this amount. 0 turns it off."
        },
        "nanometrics.claudeDailyTokenLimit": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Warn once a day, with a sound, when Claude Code's total tokens today in this workspace pass this number (e.g. 5000000). 0 turns it off."
        },
        "nanometrics.claudeSessionCostLimit": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Warn once per chat, with a sound, when a single chat's estimated cost (API pricing, USD) passes this amount. 0 turns it off."
        },
        "nanometrics.claudeSessionTokenLimit": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Warn once per chat, with a sound, when a single chat's total tokens pass this number. 0 turns it off."
        },
        "nanometrics.claudePlanPrice": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "What you pay for your Claude plan per month in USD (Pro 20, Max 100 or 200). When set, the Claude tab shows what the last 7 days would have cost on the API versus your plan. 0 hides it."
        },
        "nanometrics.claudeAlertSound": {
          "type": "boolean",
          "default": true,
          "description": "Play a warning sound with token and cost limit alerts and stuck-loop warnings (macOS, Linux, Windows)."
        },
        "nanometrics.claudeLoopWarning": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a Claude Code chat looks stuck: the same call failing again and again, or one file edited repeatedly while errors continue."
        },
        "nanometrics.notifyClaudeSession": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification, at most once per window, when a new Claude Code chat starts in this workspace."
        },
        "nanometrics.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show CPU and memory usage in the status bar."
        },
        "nanometrics.warningThreshold": {
          "type": "number",
          "default": 85,
          "minimum": 1,
          "maximum": 100,
          "description": "Usage percentage at which CPU and memory are highlighted as a warning."
        },
        "nanometrics.statusBarStyle": {
          "type": "string",
          "enum": [
            "full",
            "compact"
          ],
          "enumDescriptions": [
            "CPU and memory with icons, e.g. 12%  45%.",
            "Shortest form, e.g. 12·45%."
          ],
          "default": "full",
          "description": "How much space the status bar item takes."
        },
        "nanometrics.claudePricing": {
          "type": "object",
          "default": {},
          "description": "Override model prices (USD per million tokens) used for the Claude Code cost estimate. Keys match part of the model id, values are [input, output] or [input, output, cache read]; overrides are matched before the built-in prices. Example: { \"sonnet-5-5\": [2, 10, 0.1] }.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 3
          }
        },
        "nanometrics.showGraph": {
          "type": "boolean",
          "default": true,
          "description": "Show live history graphs for CPU, memory, network and project usage."
        },
        "nanometrics.enableMysql": {
          "type": "boolean",
          "default": false,
          "description": "Enable MySQL metrics."
        },
        "nanometrics.enableMongoDB": {
          "type": "boolean",
          "default": false,
          "description": "Enable MongoDB metrics."
        },
        "nanometrics.enableRedis": {
          "type": "boolean",
          "default": false,
          "description": "Enable Redis metrics."
        },
        "nanometrics.enableDocker": {
          "type": "boolean",
          "default": false,
          "description": "Enable Docker metrics."
        },
        "nanometrics.enableNginx": {
          "type": "boolean",
          "default": false,
          "description": "Enable Nginx metrics."
        },
        "nanometrics.enableApache": {
          "type": "boolean",
          "default": false,
          "description": "Enable Apache metrics."
        },
        "nanometrics.enableElasticsearch": {
          "type": "boolean",
          "default": false,
          "description": "Enable Elasticsearch metrics."
        },
        "nanometrics.enableRabbitMQ": {
          "type": "boolean",
          "default": false,
          "description": "Enable RabbitMQ metrics."
        },
        "nanometrics.enableKafka": {
          "type": "boolean",
          "default": false,
          "description": "Enable Kafka metrics."
        },
        "nanometrics.enablePostgres": {
          "type": "boolean",
          "default": false,
          "description": "Enable Postgres metrics."
        },
        "nanometrics.enableOracleDB": {
          "type": "boolean",
          "default": false,
          "description": "Enable OracleDB metrics."
        },
        "nanometrics.enableSqlServer": {
          "type": "boolean",
          "default": false,
          "description": "Enable SQL Server metrics."
        },
        "nanometrics.enableNeo4j": {
          "type": "boolean",
          "default": false,
          "description": "Enable Neo4j metrics."
        },
        "nanometrics.enableCassandra": {
          "type": "boolean",
          "default": false,
          "description": "Enable Cassandra metrics."
        },
        "nanometrics.enableMariaDB": {
          "type": "boolean",
          "default": false,
          "description": "Enable MariaDB metrics."
        },
        "nanometrics.enableCouchDB": {
          "type": "boolean",
          "default": false,
          "description": "Enable CouchDB metrics."
        },
        "nanometrics.enableInfluxDB": {
          "type": "boolean",
          "default": false,
          "description": "Enable InfluxDB metrics."
        },
        "nanometrics.enableClickHouse": {
          "type": "boolean",
          "default": false,
          "description": "Enable ClickHouse metrics."
        },
        "nanometrics.enableMemcached": {
          "type": "boolean",
          "default": false,
          "description": "Enable Memcached metrics."
        },
        "nanometrics.enableEtcd": {
          "type": "boolean",
          "default": false,
          "description": "Enable etcd metrics."
        },
        "nanometrics.enableConsul": {
          "type": "boolean",
          "default": false,
          "description": "Enable Consul metrics."
        },
        "nanometrics.enableZookeeper": {
          "type": "boolean",
          "default": false,
          "description": "Enable ZooKeeper metrics."
        },
        "nanometrics.enablePrometheus": {
          "type": "boolean",
          "default": false,
          "description": "Enable Prometheus metrics."
        },
        "nanometrics.enableGrafana": {
          "type": "boolean",
          "default": false,
          "description": "Enable Grafana metrics."
        },
        "nanometrics.enableMinIO": {
          "type": "boolean",
          "default": false,
          "description": "Enable MinIO metrics."
        },
        "nanometrics.enableHAProxy": {
          "type": "boolean",
          "default": false,
          "description": "Enable HAProxy metrics."
        },
        "nanometrics.enableTraefik": {
          "type": "boolean",
          "default": false,
          "description": "Enable Traefik metrics."
        },
        "nanometrics.enableOllama": {
          "type": "boolean",
          "default": false,
          "description": "Enable Ollama metrics."
        },
        "nanometrics.enableGpu": {
          "type": "boolean",
          "default": false,
          "description": "Show GPU information."
        },
        "nanometrics.enableBattery": {
          "type": "boolean",
          "default": false,
          "description": "Show battery status."
        },
        "nanometrics.enableNetwork": {
          "type": "boolean",
          "default": true,
          "description": "Show network throughput for the default interface."
        },
        "nanometrics.enableDisk": {
          "type": "boolean",
          "default": true,
          "description": "Show disk usage."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "nanometrics.togglePause",
          "when": "view == nanometrics.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "nanometrics.openSettings",
          "when": "view == nanometrics.dashboard",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "package": "node scripts/marketplace-readme.js && vsce package --readme-path README.marketplace.md",
    "compile": "tsc -p ./",
    "bench": "tsc -p ./ && node --expose-gc scripts/bench.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "test:unit": "mocha --ui tdd \"out/test/unit/**/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.19.17",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^8.56.0",
    "mocha": "^10.8.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "systeminformation": "^5.33.16"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.1",
    "serialize-javascript": "^7.1.4"
  }
}
